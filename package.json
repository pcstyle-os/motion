{
  "name": "@pcstyle/motion",
  "version": "0.1.0",
  "description": "Framer Motion variants, transitions, and animation utilities for PCSTYLE",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./variants": {
      "types": "./dist/variants/index.d.ts",
      "import": "./dist/variants/index.js"
    },
    "./transitions": {
      "types": "./dist/transitions/index.d.ts",
      "import": "./dist/transitions/index.js"
    },
    "./gestures": {
      "types": "./dist/gestures/index.d.ts",
      "import": "./dist/gestures/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./keyframes": {
      "types": "./dist/keyframes/index.d.ts",
      "import": "./dist/keyframes/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "framer-motion": ">=10",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "framer-motion": "^12",
    "react": "^19",
    "typescript": "^5"
  },
  "files": ["dist"],
  "keywords": ["animation", "framer-motion", "motion", "pcstyle", "react"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pc-style/motion.git"
  }
}
